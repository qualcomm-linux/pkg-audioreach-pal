#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

export DEB_CPPFLAGS_MAINT_APPEND = -I/usr/include/android -DPAL_SP_TEMP_PATH=\"/home/debian/audio.cal\"
export DEB_LDFLAGS_MAINT_APPEND = -L/usr/lib/aarch64-linux-gnu/android -Wl,-rpath-link,/usr/lib/aarch64-linux-gnu/android
export DEB_CFLAGS_MAINT_APPEND = -Wl,--no-undefined
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --with-glib --with-syslog --with-cutils=yes \
		--with-pal-config-dir=/etc/audioreach \
		--with-pal-data-dir=/usr/share/audioreach \
		--with-pal-plugin-dir=/usr/lib/audioreach-pal/plugins

override_dh_shlibdeps:
		dh_shlibdeps -- -l/usr/lib/aarch64-linux-gnu/android

override_dh_fixperms:
	dh_fixperms
	find debian -name "*.xml" -exec chmod 644 {} +
