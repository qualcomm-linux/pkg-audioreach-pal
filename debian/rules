#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

export DEB_CFLAGS_MAINT_APPEND = -Wl,--no-undefined
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --with-glib --with-syslog \
		--with-pal-config-dir=/etc/audioreach-pal \
		--with-pal-data-dir=/usr/share/audioreach-pal \
		--with-pal-plugin-dir=/usr/lib/$(DEB_HOST_MULTIARCH)/audioreach-pal/plugins

override_dh_fixperms:
	dh_fixperms
	find debian -name "*.xml" -exec chmod 644 {} +
